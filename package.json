{
  "name": "railgaadi",
  "version": "0.1.0",
  "private": true,
  "description": "RailGaadi — Live Train Tracker (monorepo root: separate backend + frontend)",
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "start:frontend": "cd frontend && npm start",
    "start:backend": "cd backend && npm start",
    "test:phase3": "node frontend/scripts/phase3-test.mjs",
    "test:phase4": "cd backend && node scripts/phase4-test.mjs",
    "test:phase5": "cd backend && node scripts/phase5-test.mjs",
    "test:status": "cd frontend && node --no-warnings scripts/train-status-test.mjs",
    "test:livepatch": "cd frontend && node --no-warnings scripts/live-patch-test.mjs",
    "test:phase7": "cd backend && node scripts/phase7-test.mjs",
    "test:phase8": "cd backend && node scripts/phase8-test.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
