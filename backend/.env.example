# ─── Server ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── MongoDB (local or Atlas) ────────────────────────────
MONGODB_URI=mongodb://localhost:27017/railgaadi

# ─── RailRadar API (https://railradar.in/developers) ─────
RAILRADAR_API_KEY=rr_live_xxxxxxxxxxxx
RAILRADAR_BASE_URL=https://api.railradar.in/v1

# ─── Upstash Redis (optional — caching layer) ────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Web Push (VAPID keys — generate via: npx web-push generate-vapid-keys) ─
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── CORS (comma separated origins, * for all) ──────────
CORS_ORIGINS=*

# ─── Live train tracking worker (Phase 4) ────────────────
# Runs inside the API server (and/or `node src/worker.js` standalone).
TRAIN_TRACKING_ENABLED=true
# How often each active train is fetched from RailRadar (seconds).
TRAIN_TRACKING_INTERVAL_SECONDS=60
# How often the scheduler scans journeys for new targets (seconds).
TRAIN_TRACKING_SCHEDULER_SECONDS=60
# PLANNED journeys departing within this window (minutes) are pre-warmed.
# NOTE: journeys only store a date (YYYY-MM-DD), so the window is approximated
# as "PLANNED journeys whose journeyDate is today (IST)".
TRAIN_TRACKING_PRESTART_MINUTES=180
# Max concurrent RailRadar fetches per worker cycle.
TRAIN_TRACKING_CONCURRENCY=3
# Hard cap on simultaneously tracked targets.
TRAIN_TRACKING_MAX_TARGETS=20
# Distributed lock TTL per target (seconds).
TRAIN_TRACKING_LOCK_TTL_SECONDS=30
# Consecutive failures before a target is marked ERROR.
TRAIN_TRACKING_MAX_RETRIES=3
# train_snapshots retention (days); older rows are purged by a daily cleanup.
TRAIN_SNAPSHOT_RETENTION_DAYS=90

# ─── Internal endpoints ─────────────────────────────────
# Optional bearer token for POST /api/v1/tracking/internal/tracking/test
# AND for the Phase 7 SSE stream (/api/v1/stream/*) which is guarded by
# X-Internal-Token + X-Journey-User headers set by the frontend proxy.
# Leave empty to disable the endpoint entirely.
INTERNAL_API_TOKEN=

# ─── Live train stream (Phase 7) ─────────────────────────
# Global switch for /api/v1/stream/* (SSE + metrics).
SSE_ENABLED=true
# Heartbeat interval (seconds) — keeps the connection alive through proxies.
SSE_HEARTBEAT_SECONDS=15
# How often each stream re-reads the shared Redis snapshot to replay missed
# events and converge across instances.
SSE_REDIS_SYNC_SECONDS=30
# Max simultaneous streams per user account.
SSE_MAX_CONNECTIONS_PER_USER=5
# Max simultaneous streams per backend process.
SSE_MAX_CONNECTIONS=500

# ─── Alert & notification engine (Phase 5) ───────────────
# Global switch for the alert evaluation + notification workers.
ALERTS_ENABLED=true
# A tracking target is considered stale after this many seconds without fresh
# data (default 30 min). Triggers LIVE_DATA_STALE once per stale episode.
TRAIN_STALE_THRESHOLD_SECONDS=1800
# How often the notification worker polls the Redis queue (seconds).
NOTIFY_WORKER_INTERVAL_SECONDS=10
# Max delivery attempts for a retryable notification before it is marked FAILED.
NOTIFY_MAX_RETRIES=5
# Retry backoff base (seconds); each retry doubles, capped at 10 min.
NOTIFY_RETRY_BASE_SECONDS=30
# TTL for queued notification jobs in Redis (default 7 days).
NOTIFY_QUEUE_TTL_SECONDS=604800
# TTL for the Redis notification dedupe key (default 24 h). The MongoDB unique
# sparse index on notification_logs.dedupeKey is the durable layer.
NOTIFY_DEDUPE_TTL_SECONDS=86400
