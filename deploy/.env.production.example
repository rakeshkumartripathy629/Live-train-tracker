# ──────────────────────────────────────────────────────────────
# RailGaadi — Production environment (used by docker-compose.prod.yml)
# Copy this to `.env` (repo root) on the EC2 server and fill values.
#   cp deploy/.env.production.example .env
#   nano .env
#
# Helpers:
#   setup.sh replaces CHANGE_ME in NEXTAUTH_URL / NEXT_PUBLIC_API_URL /
#   CORS_ORIGINS using PUBLIC_IP, and generates NEXTAUTH_SECRET +
#   INTERNAL_API_TOKEN automatically when left blank.
# ──────────────────────────────────────────────────────────────

# Public address of the EC2 instance (IP or later a domain). Required.
PUBLIC_IP=CHANGE_ME

# Public-facing URLs derived from PUBLIC_IP (CHANGE_ME is replaced by setup.sh)
NEXTAUTH_URL=http://CHANGE_ME
NEXT_PUBLIC_API_URL=http://CHANGE_ME/api/v1
CORS_ORIGINS=http://CHANGE_ME

# ─── MongoDB (Atlas) ──────────────────────────────────────────
# Same URI the app already uses locally (backend/.env, frontend/.env.local)
MONGODB_URI=mongodb+srv://CHANGE_ME

# ─── RailRadar API (free tier ~50 req/day) ───────────────────
RAILRADAR_API_KEY=CHANGE_ME

# ─── Upstash Redis (optional cache layer — leave blank to disable) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Web Push (VAPID) ─────────────────────────────────────────
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:dev@railgaadi.in

# ─── OpenWeather / OpenTopography (legacy frontend routes) ───
OPENWEATHER_API_KEY=CHANGE_ME
OPENTOPOGRAPHY_API_KEY=CHANGE_ME

# ─── MapTiler (public key, baked into the client build) ──────
NEXT_PUBLIC_MAPTILER_API_KEY=CHANGE_ME

# ─── Auth + internal tokens (auto-generated by setup.sh if blank) ──
NEXTAUTH_SECRET=
INTERNAL_API_TOKEN=

# ─── Phase 10 — AI assistant (FREE providers supported) ─────────
# provider: groq (default, free key from console.groq.com) | gemini | openai
# Leave AI_API_KEY blank to keep the assistant disabled (returns AI_NOT_CONFIGURED).
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=CHANGE_ME
AI_BASE_URL=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1024
AI_MAX_TOOL_CALLS=6
AI_REQUEST_TIMEOUT_MS=45000
AI_HISTORY_LIMIT=20
AI_RATE_LIMIT_PER_USER_PER_MINUTE=10
AI_RATE_LIMIT_PER_USER_PER_DAY=100
AI_MONTHLY_TOKEN_BUDGET=500000
AI_MAX_TOOL_OUTPUT_CHARS=6000
AI_MAX_MESSAGE_CHARS=4000
