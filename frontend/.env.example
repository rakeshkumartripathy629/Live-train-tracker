# ─── RailGaadi Frontend (Next.js) ───────────────────────────────────
# API backend URL (Node + Express + MongoDB backend)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ─── Auth (NextAuth.js — users & sessions in MongoDB) ───────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/bandhansutra?retryWrites=true&w=majority

# MapTiler public key — https://cloud.maptiler.com (map falls back to CARTO without it)
NEXT_PUBLIC_MAPTILER_API_KEY=

# ─── Legacy Next.js-only API routes (weather / terrain) ──────────────
RAILRADAR_API_KEY=
OPENWEATHER_API_KEY=
OPENTOPOGRAPHY_API_KEY=

# ─── Phase 7 real-time stream ────────────────────────────────────────
# Internal token shared with the backend (.env INTERNAL_API_TOKEN). Used by the
# /api/stream/journey/[id] proxy to authenticate against the backend SSE endpoint.
# The browser never sees this value.
INTERNAL_API_TOKEN=
